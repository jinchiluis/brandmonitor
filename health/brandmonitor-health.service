[Unit]
Description=Check the Brand Monitor laptop pipeline
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/brandmonitor
StateDirectory=brandmonitor-health
ExecStart=/usr/bin/python3 /var/www/brandmonitor/health/check.py --env-file /root/cost_dashboard/.env --state-file /var/lib/brandmonitor-health/state.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
